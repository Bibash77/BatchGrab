{
  "manifest_version": 3,
  "name": "Batch Grab",
  "version": "0.3.1",
  "description": "Preview and select useful images and documents. Review names, organize downloads, and track real outcomes.",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Batch Grab",
    "default_popup": "popup.html"
  }
}
